# 本機開發（預設）：SQLite，無需設定
USE_POSTGRES=0

# iPad 同 Wi‑Fi（固定 Mac IP，見 docs/ipad-lan-dev.md）
# DEV_LAN_IP=192.168.0.165
# DJANGO_DEV_PORT=8000
# 執行 ./scripts/dev-lan.sh 會自動 export USE_LAN_DEV 與 Host/CSRF 變數

# 本機用 ngrok / Tailscale 在 iPad 測試時（僅 DEBUG）
# USE_LAN_DEV=1
# DJANGO_ALLOWED_HOSTS_EXTRA=192.168.0.165
# CSRF_TRUSTED_ORIGINS_EXTRA=http://192.168.0.165:8000
# USE_NGROK=1

# Tailscale 等固定主機名（選用）
# DJANGO_ALLOWED_HOSTS_EXTRA=100.x.x.x,my-mac.tail1234.ts.net
# CSRF_TRUSTED_ORIGINS_EXTRA=https://100.x.x.x,https://my-mac.tail1234.ts.net

# iPad 遠端測本機：用 ./scripts/dev-ipad.sh（Cloudflare Quick Tunnel，免域名）

# 之後接 Supabase PostgreSQL 時：
# USE_POSTGRES=1
# SUPABASE_PROJECT_REF=your-project-ref
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Production：Google「產品資料」自動同步至接單商品（擇一或併用）
# GOOGLE_SHEETS_SPREADSHEET_ID=試算表網址中的 ID
# 私人試算表：建立 Service Account，分享試算表給該 email，貼整段 JSON：
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 或公開／已發佈 CSV 匯出網址（完整 URL）：
# GOOGLE_SHEETS_PRODUCT_CSV_URL=
# GOOGLE_SHEETS_CUSTOMER_CSV_URL=
# PRODUCT_SHEET_SYNC_INTERVAL_SECONDS=15
# CUSTOMER_SHEET_SYNC_INTERVAL_SECONDS=15
# 客戶資料：Google Sheet 同步僅在 deploy 指令或管理後台手動觸發；搜尋直接讀 PostgreSQL

# 語音辨識（OpenAI gpt-4o-mini-transcribe）
# OPENAI_API_KEY=sk-...
