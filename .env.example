# 本機開發（預設）：SQLite，無需設定
USE_POSTGRES=0

# iPad / ngrok 遠端測本機（選用，runserver 時由 scripts/dev-ngrok.sh 自動 export）
# USE_NGROK=1

# Tailscale 等固定主機名（選用）
# DJANGO_ALLOWED_HOSTS_EXTRA=100.x.x.x,my-mac.tail1234.ts.net
# CSRF_TRUSTED_ORIGINS_EXTRA=https://100.x.x.x,https://my-mac.tail1234.ts.net

# 之後接 Supabase PostgreSQL 時：
# USE_POSTGRES=1
# SUPABASE_PROJECT_REF=your-project-ref
# DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
