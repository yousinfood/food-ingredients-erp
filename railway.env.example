# Copy names/values into Railway → web → Variables (never commit real secrets).

# Required
DEBUG=False
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DATABASE_URL=${{Postgres.DATABASE_URL}}
RAILWAY_PUBLIC_DOMAIN=web-production-dfc69.up.railway.app

# Recommended on Railway (edge terminates HTTPS; avoid redirect loops)
SECURE_SSL_REDIRECT=False

# Injected by Railway (do not set manually unless debugging)
# PORT
# RAILWAY_PUBLIC_DOMAIN may also be auto-set when you generate a domain
