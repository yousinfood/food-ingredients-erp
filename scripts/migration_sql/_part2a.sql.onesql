CREATE TABLE "AI控制台" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "首頁" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "🚚 今日配送" varchar(100) NOT NULL, "💰 今日收款" varchar(100) NOT NULL, "📦 今日採購" varchar(100) NOT NULL, "⚠ 今日提醒" varchar(100) NOT NULL, "今天沒有待收款" varchar(300) NOT NULL, "今天共有5家配送" varchar(300) NOT NULL, "建議先配送仁武區" varchar(300) NOT NULL);
CREATE TABLE "改善中心" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "庫存管理" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "收款管理" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "價格管理" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "生產記錄" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "供應商資料" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "系統設定" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "廠商資料" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY);
CREATE TABLE "客戶資料" ("客戶編號" varchar(20) NOT NULL PRIMARY KEY, "區域" varchar(100) NOT NULL, "客戶名稱" varchar(200) NOT NULL UNIQUE, "聯絡人" varchar(100) NOT NULL, "📞_1" varchar(50) NOT NULL, "📞_2" varchar(50) NOT NULL, "📞_3" varchar(50) NOT NULL, "配送地址" varchar(300) NOT NULL, "發票地址" varchar(300) NOT NULL, "📍" varchar(100) NOT NULL, "🟩Line" varchar(100) NOT NULL, "付款方式" varchar(100) NOT NULL, "固定配送日" varchar(100) NOT NULL, "配送順序" integer NULL, "信用額度" numeric(14, 2) NULL, "最後交易日" date NULL, "備註" text NOT NULL);
CREATE TABLE "接單中心" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "🔍 輸入電話或客戶名稱…" varchar(200) NOT NULL, "客戶姓名" varchar(200) NOT NULL, "電話_1" varchar(50) NOT NULL, "地址_1" varchar(300) NOT NULL, "付款方式_1" varchar(100) NOT NULL, "區域" varchar(100) NOT NULL, "訂單日期" date NULL, "客戶" varchar(200) NOT NULL, "電話_2" varchar(50) NOT NULL, "地址_2" varchar(300) NOT NULL, "付款方式_2" varchar(100) NOT NULL, "品名" varchar(200) NOT NULL, "數量" numeric(14, 3) NULL, "單位" varchar(50) NOT NULL);
CREATE TABLE "產品資料" ("產品編號" varchar(20) NOT NULL PRIMARY KEY, "產品名稱" varchar(200) NOT NULL UNIQUE, "產品類型" varchar(100) NOT NULL, "規格" varchar(200) NOT NULL, "單位" varchar(50) NOT NULL, "是否販售" varchar(10) NOT NULL, "可做原料" varchar(10) NOT NULL, "啟用" varchar(10) NOT NULL, "備註" text NOT NULL, "成本" numeric(14, 2) NULL, "售價" numeric(14, 2) NULL);
CREATE TABLE "原料資料" ("原料編號" varchar(20) NOT NULL PRIMARY KEY, "原料名稱" varchar(200) NOT NULL, "分類" varchar(100) NOT NULL, "單位" varchar(50) NOT NULL, "每公斤成本" numeric(14, 4) NULL, "最新採購價" numeric(14, 4) NULL, "最近採購日" date NULL, "安全庫存" numeric(14, 3) NULL, "啟用" varchar(10) NOT NULL, "備註" text NOT NULL);
CREATE TABLE "配方主檔" ("配方ID" varchar(20) NOT NULL PRIMARY KEY, "產品名稱" varchar(200) NOT NULL, "產品類型" varchar(100) NOT NULL, "產品特性" varchar(200) NOT NULL, "配方版本" varchar(50) NOT NULL, "基準批次(kg)" numeric(14, 3) NULL, "狀態" varchar(50) NOT NULL, "建立日期" date NULL, "修改原因" varchar(300) NOT NULL, "備註" text NOT NULL, "總成本" numeric(14, 4) NULL, "每公斤成本" numeric(14, 4) NULL, "產品編號" varchar(20) NOT NULL);
CREATE TABLE "配方明細" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "項次" integer NOT NULL, "原料名稱" varchar(200) NOT NULL, "採用品項" varchar(200) NOT NULL, "用量" numeric(14, 3) NULL, "單位" varchar(50) NOT NULL, "備註" text NOT NULL, "每公斤成本" numeric(14, 4) NULL, "成本" numeric(14, 4) NULL, "原料編號" varchar(20) NOT NULL, "配方ID" varchar(20) NOT NULL);
CREATE TABLE "今日配送" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "配送日期" date NULL, "配送區" varchar(100) NOT NULL, "地址" varchar(300) NOT NULL, "數量" numeric(14, 3) NULL, "配送順序" integer NULL, "狀態" varchar(50) NOT NULL, "完成時間" timestamp with time zone NULL, "備註" text NOT NULL, "客戶" varchar(200) NULL, "產品" varchar(200) NULL);
CREATE TABLE "配送規則" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "客戶名稱" varchar(200) NOT NULL, "星期" varchar(20) NOT NULL, "配送區" varchar(100) NOT NULL, "配送順序" integer NULL, "固定數量" numeric(14, 3) NULL, "是否配送" varchar(10) NOT NULL, "備註" text NOT NULL, "建立日期" date NULL, "最後更新" timestamp with time zone NULL, "客戶編號" varchar(20) NOT NULL, "固定產品" varchar(20) NULL);
CREATE TABLE "快速查詢" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "🔍 搜尋客戶" varchar(200) NOT NULL, "區域" varchar(100) NOT NULL, "客戶名稱" varchar(200) NOT NULL, "聯絡人" varchar(100) NOT NULL, "📞_1" varchar(50) NOT NULL, "📞_2" varchar(50) NOT NULL, "📞_3" varchar(50) NOT NULL, "📍地址" varchar(300) NOT NULL, "🛒 建立訂單" varchar(100) NOT NULL, "客戶編號" varchar(20) NULL);
CREATE TABLE "採購進貨" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "進貨單號" varchar(50) NOT NULL, "日期" date NULL, "原料名稱" varchar(200) NOT NULL, "數量" numeric(14, 3) NULL, "單價" numeric(14, 4) NULL, "供應商" varchar(200) NOT NULL, "備註" text NOT NULL, "原料編號" varchar(20) NOT NULL, CONSTRAINT "uniq_purchase_receipt_line" UNIQUE ("進貨單號", "原料編號"));
CREATE TABLE "配方管理" ("id" bigint NOT NULL PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, "產品名稱" varchar(200) NOT NULL, "版本" varchar(50) NOT NULL, "原料名稱" varchar(200) NOT NULL, "用量" numeric(14, 3) NULL, "單位" varchar(50) NOT NULL, "排序" integer NULL, "是否啟用" varchar(10) NOT NULL, "備註" text NOT NULL, "原料編號" varchar(20) NOT NULL, "產品編號" varchar(20) NOT NULL);